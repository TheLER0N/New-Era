<UserControl x:Class="MainApp.QwenBrowserPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Background="#02070c" FontFamily="Consolas">
    <Grid Background="#02070c">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#07141d" Padding="12,8" BorderBrush="#12404f" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="QWEN·LINK" Foreground="#00d9ff" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text=" │ " Foreground="#12404f" FontSize="15" VerticalAlignment="Center"/>
                    <Button Content="←" Width="38" Height="30" Margin="0,0,4,0" Click="OnBackClick" ToolTip="Назад" FontSize="14" Padding="2,2"/>
                    <Button Content="→" Width="38" Height="30" Margin="0,0,4,0" Click="OnForwardClick" ToolTip="Вперёд" FontSize="14" Padding="2,2"/>
                    <Button Content="⟳" Width="38" Height="30" Margin="0,0,4,0" Click="OnReloadClick" ToolTip="Обновить" FontSize="14" Padding="2,2"/>
                    <Button Content="👤" Width="38" Height="30" Click="OnSwitchAccountClick"
                            ToolTip="Сменить аккаунт Qwen: очистить cookies/сессию и открыть вход заново"
                            FontSize="15" Padding="2,2"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Загрузка..." Foreground="#6f96a8" FontSize="15"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                <Ellipse Grid.Column="2" x:Name="LinkDot" Width="9" Height="9" Fill="#12404f" VerticalAlignment="Center"
                         ToolTip="Связь с gateway"/>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="WebView" Grid.Row="1"/>

        <Border Grid.Row="2" Background="#07141d" Padding="14,8" BorderBrush="#12404f" BorderThickness="0,1,0,0">
            <TextBlock x:Name="ConnectionStatus" Text="Инициализация..." FontSize="14" Foreground="#8fe6ff" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.RowSpan="3" x:Name="BootOverlay" Background="#02070c">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="LERON·LINK" FontSize="24" FontWeight="Bold" Foreground="#00d9ff" HorizontalAlignment="Center"/>
                <TextBlock x:Name="BootText" Text="подключение..." FontSize="15" Foreground="#8fe6ff" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="BootBar" Text="" FontSize="14" Foreground="#35606e" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>