<local:ChromeWindow x:Class="MainApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MainApp"
    Title="LERON GUI — чат"
    Width="1600" Height="800">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <local:ChromeWindow.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource LeronScrollBar}"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#c8ffd8"/>
            <Setter Property="Background" Value="#0b1d14"/>
            <Setter Property="BorderBrush" Value="#1d5c3d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#123726"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00ff88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:ChromeWindow.Resources>

    <Border BorderBrush="#123626" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ ВЕРХНЯЯ ПАНЕЛЬ ═══ -->
            <Border Grid.Row="0" Background="#081711" MouseLeftButtonDown="DragWindow" BorderBrush="#123626" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="44" Height="44" CornerRadius="8" Background="#123020" BorderBrush="#1d5c3d" BorderThickness="1">
                            <TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#00ff88" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="LERON GUI" FontSize="22" FontWeight="Bold" Foreground="#00ff88" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="· чат агента" Margin="10,0,0,0" Foreground="#447a5a" FontSize="15" VerticalAlignment="Center"/>
                        <Border Background="#0d2418" BorderBrush="#1d5c3d" BorderThickness="1" CornerRadius="10" Padding="14,6" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="OnlineDot" Width="10" Height="10" Fill="#00ff88" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OnlineText" Text="онлайн" Foreground="#7dffa8" FontSize="14" FontFamily="Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="← хаб" Padding="16,8" Margin="0,0,6,0" Click="OnBackClick" FontSize="15"/>
                        <Button Content="⧉" Width="50" Height="38" Margin="0,0,6,0" Click="ToggleSize" ToolTip="Развернуть / окно" FontSize="16"/>
                        <Button Content="✕" Width="50" Height="38" Click="CloseClick" Foreground="#e94560" ToolTip="Закрыть" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ ОСНОВНАЯ ОБЛАСТЬ ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="BrowserColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ПАНЕЛЬ -->
                <Border Grid.Column="0" Background="#08140f" BorderBrush="#123626" BorderThickness="0,0,1,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="AGENT" FontSize="14" Foreground="#00ff88" FontWeight="Bold" FontFamily="Consolas" Margin="2,0,0,10"/>

                        <Border Grid.Row="1" Background="#0d2418" BorderBrush="#00ff88" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" CornerRadius="8" Background="#123020" BorderBrush="#1d5c3d" BorderThickness="1">
                                    <TextBlock Text="💻" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Кодер" FontSize="18" FontWeight="Bold" Foreground="#d9ffe7"/>
                                    <TextBlock x:Name="AgentStatusText" Text="онлайн · готов к работе" FontSize="13" Foreground="#7dffa8" FontFamily="Consolas" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12" Background="#00ff88" VerticalAlignment="Top">
                                    <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="#04150c" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Button Grid.Row="2" x:Name="ToggleBrowserBtn" Content="🌐 браузер: скрыт" Click="OnToggleBrowserClick" Padding="14,10" Margin="0,12,0,0" HorizontalContentAlignment="Left" FontSize="15"/>

                        <TextBlock Grid.Row="3" Text="СЕССИЯ" FontSize="14" Foreground="#00ff88" FontWeight="Bold" FontFamily="Consolas" Margin="2,20,0,8"/>

                        <Border Grid.Row="4" Background="#0d2418" BorderBrush="#123626" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid TextElement.FontFamily="Consolas" TextElement.FontSize="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Роль:" Foreground="#447a5a" Margin="0,0,0,8"/>
                                <TextBlock Grid.Column="1" x:Name="SessionRoleText" Text="coder" Foreground="#d9ffe7" FontWeight="Bold" Margin="10,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="Стиль:" Foreground="#447a5a" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SessionStyleText" Text="аккуратный" Foreground="#d9ffe7" Margin="10,0,0,8"/>
                                <TextBlock Grid.Row="2" Text="Скорость:" Foreground="#447a5a" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SessionSpeedText" Text="быстро" Foreground="#d9ffe7" Margin="10,0,0,8"/>
                                <TextBlock Grid.Row="3" Text="Проект:" Foreground="#447a5a" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SessionProjectText" Text="—" Foreground="#00ff88" Margin="10,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="4" Text="Путь:" Foreground="#447a5a"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SessionPathText" Text="—" Foreground="#7dffa8" Margin="10,0,0,0" TextWrapping="Wrap" FontSize="12"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="6" x:Name="RoleStatus" Text="" Foreground="#8fe3ae" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap" Margin="2,8,0,0"/>
                    </Grid>
                </Border>

                <!-- ЦЕНТР: ЧАТ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" HorizontalAlignment="Center" Background="#0d2418" BorderBrush="#123626" BorderThickness="1" CornerRadius="10" Padding="18,6" Margin="0,12,0,0">
                        <TextBlock Text="Сегодня" Foreground="#7dffa8" FontSize="14" FontFamily="Consolas"/>
                    </Border>

                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,10">
                        <StackPanel x:Name="ChatMessages"/>
                    </ScrollViewer>

                    <!-- НИЖНЯЯ ПАНЕЛЬ ВВОДА (увеличена) -->
                    <Border Grid.Row="2" Background="#081711" Padding="16,14" BorderBrush="#123626" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="ModeChatBtn" Content="💬 чат" Click="OnModeChatClick" Margin="0,0,6,0" ToolTip="Обычный разговор без проекта" FontSize="14"/>
                                <Button x:Name="ModeProjectBtn" Content="📋 планирование" Click="OnModeProjectClick" Margin="0,0,6,0" ToolTip="ИИ читает и обсуждает проект, но не меняет файлы" FontSize="14"/>
                                <Button x:Name="ModeEditBtn" Content="✏️ аккуратный" Click="OnModeEditClick" Margin="0,0,6,0" ToolTip="ИИ правит файлы, каждое действие с подтверждением" FontSize="14"/>
                                <Button x:Name="ModeAutoBtn" Content="🔄 авто" Click="OnModeAutoClick" Margin="0,0,6,0" ToolTip="Подтвердил действие один раз — похожие дальше идут сами" FontSize="14"/>
                                <Button x:Name="ModeYoloBtn" Content="⚡ агрессивный" Click="OnModeYoloClick" Margin="0,0,6,0" ToolTip="YOLO: обычные действия без подтверждений" FontSize="14"/>
                                <Button x:Name="ModeRepairBtn" Content="🔧 ремонт" Click="OnModeRepairClick" Margin="0,0,6,0" ToolTip="Минимальный ремонт одной ошибки" FontSize="14"/>
                                <Button x:Name="AutoRepairBtn" Content="🔧 авторемонт: вкл" Click="OnAutoRepairClick" Margin="0,0,6,0" ToolTip="Автоматическая проверка проекта после изменений" FontSize="14"/>
                                <TextBlock Text="│" Foreground="#1d5c3d" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                <Button x:Name="ThinkBtn" Content="⚡ быстро" Click="OnThinkClick" Margin="0,0,6,0" ToolTip="Режим ответа ИИ: быстро или с мышление (Ctrl+6)" FontSize="14"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="InputBox"
                                             Background="#04110c"
                                             Foreground="#d9ffe7"
                                             BorderBrush="#1d5c3d"
                                             BorderThickness="1"
                                             Padding="14,12"
                                             FontSize="16"
                                             FontFamily="Consolas"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             CaretBrush="#00ff88"
                                             SelectionBrush="#123626"
                                             IsEnabled="False"
                                             KeyDown="OnInputKeyDown"
                                             MinHeight="52"/>
                                    <TextBlock x:Name="InputPlaceholder"
                                               Text="Введите сообщение..."
                                               Foreground="#3d6a4d"
                                               FontSize="16"
                                               FontFamily="Consolas"
                                               Margin="16,14,0,0"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <Button x:Name="SendBtn"
                                        Grid.Column="1"
                                        Content="Отправить ➤"
                                        Width="180"
                                        Margin="12,0,0,0"
                                        IsEnabled="False"
                                        Click="OnSendClick"
                                        Background="#00ff88"
                                        Foreground="#04150c"
                                        FontWeight="Bold"
                                        FontSize="16"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- РАЗДЕЛИТЕЛЬ (перетаскиваемый) -->
                <GridSplitter x:Name="BrowserSplitter"
                              Grid.Column="2"
                              Width="7"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="#1d5c3d"
                              Cursor="SizeWE"
                              Visibility="Collapsed"
                              ToolTip="Потяни для изменения ширины браузера"/>

                <!-- ПРАВАЯ ПАНЕЛЬ: БРАУЗЕР -->
                <Border Grid.Column="3" x:Name="BrowserPaneHost" BorderBrush="#123626" BorderThickness="1,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</local:ChromeWindow>