<local:ChromeWindow x:Class="MainApp.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:MainApp"
Title="LERON CLI — чат"
Width="1600" Height="800">
<WindowChrome.WindowChrome>
<WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" NonClientFrameEdges="None"/>
</WindowChrome.WindowChrome>
<local:ChromeWindow.Resources>
<Style TargetType="Button">
<Setter Property="Foreground" Value="#c8ffd8"/>
<Setter Property="Background" Value="#0b1d14"/>
<Setter Property="BorderBrush" Value="#1d5c3d"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="Padding" Value="10,6"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border x:Name="bd"
Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="8"
Padding="{TemplateBinding Padding}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="bd" Property="Background" Value="#123726"/>
<Setter TargetName="bd" Property="BorderBrush" Value="#00ff88"/>
</Trigger>
<Trigger Property="IsEnabled" Value="False">
<Setter Property="Opacity" Value="0.45"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
<Style TargetType="ListBox">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="BorderThickness" Value="0"/>
</Style>
<Style TargetType="ListBoxItem">
<Setter Property="Foreground" Value="#c8ffd8"/>
<Setter Property="FontSize" Value="14"/>
<Setter Property="Padding" Value="8"/>
<Setter Property="Margin" Value="0,2"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="ListBoxItem">
<Border x:Name="bd"
Background="#0a1a12"
BorderBrush="#123626"
BorderThickness="1"
CornerRadius="6"
Padding="{TemplateBinding Padding}">
<ContentPresenter/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="bd" Property="BorderBrush" Value="#00ff88"/>
</Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="bd" Property="Background" Value="#123626"/>
<Setter TargetName="bd" Property="BorderBrush" Value="#00ff88"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</local:ChromeWindow.Resources>
<Border BorderBrush="#123626" BorderThickness="1">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="46"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<Border Grid.Row="0" Background="#081711" MouseLeftButtonDown="DragWindow">
<Grid>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
<TextBlock Text="LERON CLI" FontSize="18" FontWeight="Bold" Foreground="#00ff88" VerticalAlignment="Center"/>
<TextBlock Text="· чат агента" Margin="10,0,0,0" Foreground="#447a5a" FontSize="14" VerticalAlignment="Center"/>
</StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
<Button Content="← хаб" Padding="10,5" Margin="0,0,6,0" Click="OnBackClick"/>
<Button Content="⛶" Width="44" Height="32" Margin="0,0,6,0" Click="ToggleSize"/>
<Button Content="✕" Width="44" Height="32" Click="CloseClick"/>
</StackPanel>
</Grid>
</Border>
<Grid Grid.Row="1">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="280"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition x:Name="BrowserColumn" Width="0"/>
</Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#08140f" BorderBrush="#123626" BorderThickness="0,0,1,0" Padding="12">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="АГЕНТ" FontSize="14" Foreground="#00ff88" FontWeight="Bold" Margin="6,0,0,10"/>
<ListBox Grid.Row="1" x:Name="RolesList" SelectionChanged="OnRoleSelected">
<ListBoxItem Tag="coder" Content="💻 Кодер"/>
</ListBox>
<Button Grid.Row="2" x:Name="ToggleBrowserBtn" Content="🌐 браузер: скрыт" Click="OnToggleBrowserClick"
Padding="8,6" Margin="0,8,0,0"
ToolTip="Показать/скрыть встроенный браузер Qwen. Даже скрытым он продолжает работать и принимать ответы."/>
<TextBlock Grid.Row="4" x:Name="RoleStatus" Text="Выбери роль" Foreground="#8fe3ae" FontSize="14" TextWrapping="Wrap" Margin="6,10,0,0"/>
</Grid>
</Border>
<Grid Grid.Column="1">
<Grid.RowDefinitions>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<ScrollViewer x:Name="ChatScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
<StackPanel x:Name="ChatMessages"/>
</ScrollViewer>
<Border Grid.Row="1" Background="#081711" Padding="12">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
<Button x:Name="ModeEditBtn" Content="✏️ правка" Click="OnModeEditClick" Padding="8,5" Margin="0,0,6,0" ToolTip="ИИ пишет и меняет файлы проекта"/>
<Button x:Name="ModeChatBtn" Content="💬 чат" Click="OnModeChatClick" Padding="8,5" Margin="0,0,6,0" ToolTip="Обычный разговор без проекта"/>
<Button x:Name="ModeProjectBtn" Content="📋 без правок" Click="OnModeProjectClick" Padding="8,5" Margin="0,0,14,0" ToolTip="ИИ обсуждает проект, но не меняет файлы"/>
<Button Content="📂 файлы" Click="OnToolListClick" Padding="8,5" Margin="0,0,6,0" ToolTip="Показать файлы проекта"/>
<Button Content="📖 читать" Click="OnToolReadClick" Padding="8,5" Margin="0,0,6,0" ToolTip="Прочитать файл проекта"/>
<Button Content="✚ создать" Click="OnToolWriteClick" Padding="8,5" Margin="0,0,6,0" ToolTip="Создать файл в проекте"/>
<Button Content="🗑 удалить" Click="OnToolDeleteClick" Padding="8,5" Margin="0,0,14,0" ToolTip="Удалить файл из проекта"/>
<TextBlock Text="/list /read /write /delete" Foreground="#3d6a4d" FontSize="12" VerticalAlignment="Center"/>
</StackPanel>
<Grid Grid.Row="1">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBox x:Name="InputBox"
Grid.Column="0"
Background="#04110c"
Foreground="#d9ffe7"
BorderBrush="#1d5c3d"
BorderThickness="1"
Padding="10"
FontSize="15"
TextWrapping="Wrap"
AcceptsReturn="False"
CaretBrush="#00ff88"
SelectionBrush="#123626"
IsEnabled="False"
KeyDown="OnInputKeyDown"/>
<Button x:Name="SendBtn" Grid.Column="1" Content="Отправить" Width="140" Margin="10,0,0,0" IsEnabled="False" Click="OnSendClick"/>
</Grid>
</Grid>
</Border>
</Grid>
<Border Grid.Column="2" x:Name="BrowserPaneHost" BorderBrush="#123626" BorderThickness="1,0,0,0"/>
</Grid>
</Grid>
</Border>
</local:ChromeWindow>