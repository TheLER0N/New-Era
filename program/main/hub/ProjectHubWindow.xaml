<local:ChromeWindow x:Class="MainApp.ProjectHubWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MainApp"
    Title="LERON GUI — проекты"
    Width="1100" Height="760"
    KeyDown="OnKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <local:ChromeWindow.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource LeronScrollBar}"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#c8ffd8"/>
            <Setter Property="Background" Value="#0b1d14"/>
            <Setter Property="BorderBrush" Value="#1d5c3d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#123726"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00ff88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:ChromeWindow.Resources>

    <Border BorderBrush="#123626" BorderThickness="1" Background="#04150c">
        <Grid x:Name="RootGrid" Background="#04150c">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#081711" MouseLeftButtonDown="DragWindow">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="44" Height="44" CornerRadius="8" Background="#123020" BorderBrush="#1d5c3d" BorderThickness="1">
                            <TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#00ff88" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="LERON GUI" FontSize="22" FontWeight="Bold" Foreground="#00ff88" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="· хаб проектов" Margin="10,0,0,0" Foreground="#447a5a" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="⛶" Width="50" Height="38" Margin="0,0,6,0" Click="ToggleSize" FontSize="16"/>
                        <Button Content="✕" Width="50" Height="38" Click="CloseClick" Foreground="#e94560" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,18,20,14" Background="#04150c">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ПРОЕКТЫ" FontSize="20" FontWeight="Bold" Foreground="#c8ffd8"/>
                    <Border Background="#123020" CornerRadius="6" Padding="12,5" Margin="14,0,0,0">
                        <TextBlock x:Name="CountText" Text="0" FontSize="16" Foreground="#00ff88"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="+ новый проект (N)" Padding="20,11" Click="OnNewProjectButtonClick" FontSize="15"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0" Padding="0,0,0,12" Background="#04150c">
                <StackPanel>
                    <StackPanel x:Name="ProjectsPanel"/>
                    <Grid x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,28,0,0" Width="480" Height="190">
                        <Rectangle Stroke="#1d5c3d" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="12" RadiusY="12" Fill="#061a10"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📁+" FontSize="30" Foreground="#2f6a4a" HorizontalAlignment="Center"/>
                            <TextBlock Text="Больше проектов нет" FontSize="16" Foreground="#4a7a5a" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock Text="Нажмите N, чтобы создать новый проект" FontSize="14" Foreground="#2f6a4a" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#081711" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterLeft" Text="Нет проектов — нажми N" Foreground="#8fe3ae" FontSize="15" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Enter — открыть · N — новый · S — чат · Q — выход" Foreground="#447a5a" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="чат (S)" Padding="16,9" Margin="0,0,8,0" Click="OnConfigureClick" FontSize="15"/>
                        <Button Content="выход (Q)" Padding="16,9" Click="OnExitClick" FontSize="15"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ChromeWindow>