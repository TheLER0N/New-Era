<local:ChromeWindow x:Class="MainApp.ProjectHubWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:MainApp"
Title="LERON GUI — проекты"
Width="1100" Height="760"
KeyDown="OnKeyDown">
<WindowChrome.WindowChrome>
<WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" NonClientFrameEdges="None"/>
</WindowChrome.WindowChrome>
<local:ChromeWindow.Resources>
<Style TargetType="ScrollBar" BasedOn="{StaticResource LeronScrollBar}"/>
<Style TargetType="Button">
<Setter Property="Foreground" Value="#eaf6ff"/>
<Setter Property="Background" Value="#07141d"/>
<Setter Property="BorderBrush" Value="#12404f"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="FontFamily" Value="Consolas"/>
<Setter Property="FontSize" Value="15"/>
<Setter Property="Padding" Value="14,8"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border x:Name="bd"
Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="8"
Padding="{TemplateBinding Padding}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="bd" Property="Background" Value="#0a1c28"/>
<Setter TargetName="bd" Property="BorderBrush" Value="#00d9ff"/>
</Trigger>
<Trigger Property="IsEnabled" Value="False">
<Setter Property="Opacity" Value="0.45"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</local:ChromeWindow.Resources>
<Border BorderBrush="#12404f" BorderThickness="1" Background="#02070c">
<Grid x:Name="RootGrid" Background="#02070c">
        <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Border Grid.Row="0" Background="#07141d" MouseLeftButtonDown="DragWindow" BorderBrush="#12404f" BorderThickness="0,0,0,1">
<Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
<Border Width="44" Height="44" CornerRadius="8" Background="#0d2433" BorderBrush="#12404f" BorderThickness="1">
<TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#00d9ff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<TextBlock Text="LERON GUI" FontSize="22" FontWeight="Bold" Foreground="#00d9ff" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0"/>
<TextBlock Text="· хаб проектов" Margin="10,0,0,0" Foreground="#6f96a8" FontSize="15" VerticalAlignment="Center"/>
</StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
<Button Content="⛶" Width="50" Height="38" Margin="0,0,6,0" Click="ToggleSize" FontSize="16"/>
<Button Content="✕" Width="50" Height="38" Click="CloseClick" Foreground="#e94560" FontSize="16"/>
</StackPanel>
</Grid>
</Border>
<Grid Grid.Row="1" Margin="20,18,20,14">
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<TextBlock Text="ПРОЕКТЫ" FontSize="20" FontWeight="Bold" Foreground="#eaf6ff"/>
<Border Background="#0a1c28" BorderBrush="#12404f" BorderThickness="1" CornerRadius="6" Padding="12,5" Margin="14,0,0,0">
<TextBlock x:Name="CountText" Text="0" FontSize="16" Foreground="#00d9ff"/>
</Border>
</StackPanel>
<Button Grid.Column="1" Content="+ новый проект (N)" Padding="20,11" Click="OnNewProjectButtonClick" FontSize="15"/>
</Grid>
<Grid Grid.Row="2">
        <Rectangle x:Name="GridBold" IsHitTestVisible="False"/>
<Rectangle x:Name="GridFine" IsHitTestVisible="False"/>
<Canvas x:Name="WorldCanvas" Background="Transparent"/>
<Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
<Canvas x:Name="MenuCanvas"/>
<StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" IsHitTestVisible="False">
<TextBlock x:Name="TraceText" Text="TRACE 0x0000" FontFamily="Consolas" FontSize="12" Foreground="#6f96a8"/>
<TextBlock x:Name="XyText" Text="X:000 Y:000" FontFamily="Consolas" FontSize="12" Foreground="#6f96a8" Margin="0,4,0,0"/>
</StackPanel>
<StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Orientation="Horizontal">
<Button x:Name="PointBtn" Content="+ точка (T)" Click="OnPointButtonClick" Padding="12,6" FontSize="13" Margin="0,0,8,0"/>
<Button x:Name="ZoneBtn" Content="＋ зона (Z)" Click="OnZoneButtonClick" Padding="12,6" FontSize="13" Margin="0,0,8,0"/>
<Border Background="#07141d" BorderBrush="#12404f" BorderThickness="1" CornerRadius="8" Padding="6,4">
<StackPanel Orientation="Horizontal">
<Button Content="−" Click="OnZoomOutClick" Width="26" Height="24" FontSize="14" Padding="0"/>
<TextBlock x:Name="ZoomText" Text="100%" Width="52" TextAlignment="Center" VerticalAlignment="Center" Foreground="#8fe6ff" FontSize="13" Cursor="Hand" MouseLeftButtonUp="OnZoomTextClick"/>
<TextBox x:Name="ZoomInput" Width="52" Visibility="Collapsed" FontSize="13" KeyDown="OnZoomInputKeyDown" LostKeyboardFocus="OnZoomInputLostFocus"/>
<Button Content="+" Click="OnZoomInClick" Width="26" Height="24" FontSize="14" Padding="0"/>
<Button Content="⛶" Click="OnFitAllClick" Width="26" Height="24" FontSize="14" Padding="0" Margin="6,0,0,0" ToolTip="Вписать всё (F)"/>
</StackPanel>
</Border>
</StackPanel>
<Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Height="190" Visibility="Collapsed">
        <Rectangle Stroke="#12404f" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="12" RadiusY="12" Fill="#07141d"/>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
<TextBlock Text="📁+" FontSize="30" Foreground="#35606e" HorizontalAlignment="Center"/>
<TextBlock Text="Больше проектов нет" FontSize="16" Foreground="#8fe6ff" HorizontalAlignment="Center" Margin="0,10,0,4"/>
<TextBlock Text="Нажмите N, чтобы создать новый проект" FontSize="14" Foreground="#6f96a8" HorizontalAlignment="Center"/>
</StackPanel>
</Grid>
</Grid>
<Border Grid.Row="3" Background="#07141d" Padding="18,14" BorderBrush="#12404f" BorderThickness="0,1,0,0">
<Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBlock x:Name="FooterLeft" Text="Нет проектов — нажми N" Foreground="#8fe6ff" FontSize="15" VerticalAlignment="Center"/>
<StackPanel Grid.Column="1" Orientation="Horizontal">
<TextBlock Text="Enter — открыть · N — новый · T — точка · M — к точке · Z — зона · Shift+ЛКМ — рамка · Ctrl+Shift+A — выровнять · F — вписать · Del — убрать · Q — выход" Foreground="#6f96a8" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
<Button Content="⚙ Настройки" Padding="16,9" Margin="0,0,8,0" Click="Settings_Click" FontSize="15"/>
                    <Button Content="чат (S)" Padding="16,9" Margin="0,0,8,0" Click="OnConfigureClick" FontSize="15"/>
<Button Content="выход (Q)" Padding="16,9" Click="OnExitClick" FontSize="15"/>
</StackPanel>
</Grid>
</Border>
</Grid>
</Border>
</local:ChromeWindow>