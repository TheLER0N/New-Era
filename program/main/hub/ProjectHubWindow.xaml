<local:ChromeWindow x:Class="MainApp.ProjectHubWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:MainApp"
Title="LERON CLI — проекты"
Width="980" Height="700"
KeyDown="OnKeyDown">
<WindowChrome.WindowChrome>
<WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" NonClientFrameEdges="None"/>
</WindowChrome.WindowChrome>
<local:ChromeWindow.Resources>
<Style TargetType="Button">
<Setter Property="Foreground" Value="#c8ffd8"/>
<Setter Property="Background" Value="#0b1d14"/>
<Setter Property="BorderBrush" Value="#1d5c3d"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="Padding" Value="10,6"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border x:Name="bd"
Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="8"
Padding="{TemplateBinding Padding}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="bd" Property="Background" Value="#123726"/>
<Setter TargetName="bd" Property="BorderBrush" Value="#00ff88"/>
</Trigger>
<Trigger Property="IsEnabled" Value="False">
<Setter Property="Opacity" Value="0.45"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</local:ChromeWindow.Resources>
<Border BorderBrush="#123626" BorderThickness="1" Background="#04150c">
<Grid x:Name="RootGrid" Background="#04150c">
<Grid.RowDefinitions>
<RowDefinition Height="52"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Border Grid.Row="0" Background="#081711" MouseLeftButtonDown="DragWindow">
<Grid>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
<Border Width="34" Height="34" CornerRadius="8" Background="#123020" BorderBrush="#1d5c3d" BorderThickness="1" Margin="0,0,12,0">
<TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#00ff88" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<TextBlock Text="LERON CLI" FontSize="18" FontWeight="Bold" Foreground="#00ff88" VerticalAlignment="Center"/>
<TextBlock Text="· хаб проектов" Margin="10,0,0,0" Foreground="#447a5a" FontSize="13" VerticalAlignment="Center"/>
</StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
<Button Content="⛶" Width="44" Height="32" Margin="0,0,6,0" Click="ToggleSize"/>
<Button Content="✕" Width="44" Height="32" Click="CloseClick" Foreground="#e94560"/>
</StackPanel>
</Grid>
</Border>
<Grid Grid.Row="1" Margin="20,18,20,12">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<TextBlock Text="ПРОЕКТЫ" FontSize="16" FontWeight="Bold" Foreground="#c8ffd8"/>
<Border Background="#123020" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
<TextBlock x:Name="CountText" Text="0" FontSize="13" Foreground="#00ff88"/>
</Border>
</StackPanel>
<Button Grid.Column="1" Content="+ новый проект (N)" Padding="16,9" Click="OnNewProjectButtonClick"/>
</Grid>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0" Padding="0,0,0,12">
<StackPanel>
<StackPanel x:Name="ProjectsPanel"/>
<Grid HorizontalAlignment="Center" Margin="0,28,0,4" Width="440" Height="170">
<Rectangle Stroke="#1d5c3d" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="12" RadiusY="12" Fill="#061a10"/>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
<TextBlock Text="📁 +" FontFamily="Consolas" FontSize="24" Foreground="#2f6a4a" HorizontalAlignment="Center"/>
<TextBlock Text="Больше проектов нет" FontSize="13" Foreground="#4a7a5a" HorizontalAlignment="Center" Margin="0,10,0,4"/>
<TextBlock Text="Нажмите N, чтобы создать новый проект" FontSize="12" Foreground="#2f6a4a" HorizontalAlignment="Center"/>
</StackPanel>
</Grid>
</StackPanel>
</ScrollViewer>
<Border Grid.Row="3" Background="#081711" Padding="16,12">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<Ellipse Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,10,0"/>
<TextBlock x:Name="FooterLeft" Text="Нет проектов — нажми N" Foreground="#8fe3ae" FontSize="13" VerticalAlignment="Center"/>
</StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
<StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
<Border BorderBrush="#1d5c3d" BorderThickness="1" CornerRadius="5" Padding="7,3" Background="#0b1d14">
<TextBlock Text="Enter" FontFamily="Consolas" FontSize="12" Foreground="#7dffa8"/>
</Border>
<TextBlock Text="открыть" FontSize="12" Foreground="#447a5a" Margin="6,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
<Border BorderBrush="#1d5c3d" BorderThickness="1" CornerRadius="5" Padding="7,3" Background="#0b1d14">
<TextBlock Text="N" FontFamily="Consolas" FontSize="12" Foreground="#7dffa8"/>
</Border>
<TextBlock Text="новый" FontSize="12" Foreground="#447a5a" Margin="6,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
<Border BorderBrush="#1d5c3d" BorderThickness="1" CornerRadius="5" Padding="7,3" Background="#0b1d14">
<TextBlock Text="S" FontFamily="Consolas" FontSize="12" Foreground="#7dffa8"/>
</Border>
<TextBlock Text="чат" FontSize="12" Foreground="#447a5a" Margin="6,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
<Border BorderBrush="#1d5c3d" BorderThickness="1" CornerRadius="5" Padding="7,3" Background="#0b1d14">
<TextBlock Text="Q" FontFamily="Consolas" FontSize="12" Foreground="#7dffa8"/>
</Border>
<TextBlock Text="выход" FontSize="12" Foreground="#447a5a" Margin="6,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
<Button Content="чат (S)" Padding="14,8" Margin="0,0,8,0" Click="OnConfigureClick"
Background="#123020" BorderBrush="#00ff88" Foreground="#00ff88"/>
<Button Content="выход (Q)" Padding="14,8" Click="OnExitClick"
Background="#1a0f14" BorderBrush="#e94560" Foreground="#e94560"/>
</StackPanel>
</Grid>
</Border>
</Grid>
</Border>
</local:ChromeWindow>