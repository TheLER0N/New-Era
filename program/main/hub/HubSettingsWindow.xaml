<Window x:Class="Hub.HubSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Хаба" Height="450" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Имя пользователя:" FontWeight="Bold"/>
            <TextBox x:Name="TxtUsername" Margin="0,5,0,10" Padding="5"/>
            <TextBlock Text="Описание:" FontWeight="Bold"/>
            <TextBox x:Name="TxtDescription" AcceptsReturn="True" Height="60" Margin="0,5,0,0" Padding="5"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Тесты инструментов:" FontWeight="Bold" Margin="0,0,0,10"/>
        <WrapPanel Grid.Row="2" VerticalAlignment="Top">
            <Button Content="Точное чтение" Width="120" Margin="5" Click="TestReadExact_Click"/>
            <Button Content="Точная перезапись" Width="120" Margin="5" Click="TestWriteLines_Click"/>
            <Button Content="Вставка" Width="120" Margin="5" Click="TestInsert_Click"/>
            <Button Content="Полная перезапись" Width="120" Margin="5" Click="TestWriteFull_Click"/>
            <Button Content="Полный тест GUI" Width="120" Margin="5" Click="TestFullGui_Click" Background="#FFDDDDDD" FontWeight="Bold"/>
        </WrapPanel>

        <Button Grid.Row="3" Content="Сохранить" Width="100" HorizontalAlignment="Right" Padding="10,5" Click="Save_Click"/>
    </Grid>
</Window>
