<UserControl x:Class="Hub.HubSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#050d13"
             FontFamily="Consolas"
             Focusable="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BgMain" Color="#050d13"/>
        <SolidColorBrush x:Key="BgPanel" Color="#07141d"/>
        <SolidColorBrush x:Key="BgHover" Color="#0a1c28"/>
        <SolidColorBrush x:Key="Border" Color="#12404f"/>
        <SolidColorBrush x:Key="Accent" Color="#00d9ff"/>
        <SolidColorBrush x:Key="TextMain" Color="#eaf6ff"/>
        <SolidColorBrush x:Key="TextSec" Color="#8fe6ff"/>
        <SolidColorBrush x:Key="TextDim" Color="#6f96a8"/>
        <SolidColorBrush x:Key="Ok" Color="#3fd158"/>
        <SolidColorBrush x:Key="Err" Color="#e94560"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SideItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSec}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid>
                                <Rectangle x:Name="activeBar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/></Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="activeBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#050d13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#0b2530"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#113344"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#00d9ff" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙" Foreground="{StaticResource Accent}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="НАСТРОЙКИ // HUB" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#050d13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Margin="24,0" MaxWidth="300" HorizontalAlignment="Left">
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" Padding="10,6" FontSize="13" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="поиск по настройкам... (/)" Foreground="{StaticResource TextDim}" FontSize="13" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <Button Grid.Column="3" Content="← назад (Esc)" Style="{StaticResource BtnSecondary}" Click="Back_Click" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32">
                        <Ellipse Fill="{StaticResource Accent}"/>
                        <TextBlock x:Name="AvatarLetter" Text="U" Foreground="#050d13" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderUsername" Text="User" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="online" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="МЕНЮ" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="Bold" Margin="16,0,0,8"/>
                        <Button x:Name="MenuProfile" Content="👤 Профиль" Style="{StaticResource SideItem}" Tag="Active" Click="Menu_Click"/>
                        <Button x:Name="MenuTools" Content="🛠 Инструменты" Style="{StaticResource SideItem}" Click="Menu_Click"/>
                        <Button x:Name="MenuTests" Content="🧪 Тесты" Style="{StaticResource SideItem}" Click="Menu_Click"/>
                        <Button x:Name="MenuLogs" Content="📜 Логи" Style="{StaticResource SideItem}" Click="Menu_Click"/>
                        <Button x:Name="MenuHotkeys" Content="⌨ Горячие клавиши" Style="{StaticResource SideItem}" Click="Menu_Click"/>
                        <Button x:Name="MenuAbout" Content="ℹ О системе" Style="{StaticResource SideItem}" Click="Menu_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#050d13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SystemStatusDot" Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SystemStatusText" Text="все системы OK" Foreground="{StaticResource TextMain}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="VersionText" Text="версия v1.0.0" Foreground="{StaticResource TextDim}" FontSize="11" Margin="14,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgMain}" Padding="24">
                <Grid>
                    <StackPanel x:Name="PanelProfile">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="— ПРОФИЛЬ —" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="64" Height="64" Margin="0,0,16,0">
                                        <Ellipse Fill="{StaticResource Accent}"/>
                                        <TextBlock x:Name="ProfileAvatarLetter" Text="U" Foreground="#050d13" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ProfileName" Text="User" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock x:Name="ProfileRole" Text="оператор LERON" Foreground="{StaticResource TextDim}" FontSize="13"/>
                                    </StackPanel>
                                    <Border x:Name="SavedBadge" Grid.Column="2" Background="#113322" BorderBrush="{StaticResource Ok}" BorderThickness="1" CornerRadius="4" Padding="8,4" Visibility="Collapsed">
                                        <TextBlock Text="✓ сохранено" Foreground="{StaticResource Ok}" FontSize="11"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Имя пользователя" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TxtUsername" Style="{StaticResource Field}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Описание (роль)" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TxtDescription" Style="{StaticResource Field}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelTests" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="— ТЕСТЫ ИНСТРУМЕНТОВ —" Style="{StaticResource SectionTitle}"/>
                                    <Border Background="#112233" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TestsCountBadge" Text="5 тестов" Foreground="{StaticResource Accent}" FontSize="11"/>
                                    </Border>
                                </Grid>
                                <StackPanel x:Name="TestsContainer" Margin="0,8,0,16"/>
                                <Button x:Name="BtnFullTest" Content="⚡ Полный тест GUI" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Click="TestFullGui_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelLogs" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="— ПОСЛЕДНИЕ ЛОГИ —" Style="{StaticResource SectionTitle}"/>
                                    <Button Content="📁 открыть папку logs/" Style="{StaticResource BtnSecondary}" Padding="8,4" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenLogsDir_Click"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ВРЕМЯ" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Column="1" Text="ТЕСТ" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Column="2" Text="РЕЗУЛЬТАТ" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                </Grid>
                                <StackPanel x:Name="LogsContainer"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelTools" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <TextBlock Text="— ИНСТРУМЕНТЫ — (в разработке)" Foreground="{StaticResource TextDim}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelHotkeys" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="— ГОРЯЧИЕ КЛАВИШИ —" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Esc — закрыть настройки" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                                <TextBlock Text="/ — фокус на поиск" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                                <TextBlock Text="Ctrl+S — сохранить" Foreground="{StaticResource TextMain}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="— О СИСТЕМЕ / ДИАГНОСТИКА —" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="DiagLog" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextSec}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="LogsCountText" Grid.Column="1" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сброс" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="Reset_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
