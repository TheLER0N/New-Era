<UserControl x:Class="Hub.HubSettingsPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Background="#050d13"
FontFamily="Consolas"
Focusable="True">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

<!-- ШАПКА -->
<Border Grid.Row="0" Background="#07141d" BorderBrush="#12404f" BorderThickness="0,0,0,1" Padding="16,10">
<Grid>
<TextBlock Text="⚙  НАСТРОЙКИ // HUB"
Foreground="#00d9ff" FontSize="16" FontWeight="Bold"
VerticalAlignment="Center"/>
<Button Content="← назад (Esc)" HorizontalAlignment="Right"
Background="#0b2530" Foreground="#eaf6ff"
BorderBrush="#12404f" BorderThickness="1"
Padding="12,6" FontFamily="Consolas" FontSize="12"
Cursor="Hand"
Click="Back_Click"/>
</Grid>
</Border>

<!-- КОНТЕНТ -->
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
Background="#050d13">
<StackPanel MaxWidth="900" Margin="24,20,24,20">

<TextBlock Text="── ПРОФИЛЬ ──" Foreground="#6f96a8" FontSize="13" Margin="0,0,0,12"/>

<TextBlock Text="Имя пользователя:" Foreground="#eaf6ff" FontSize="13" Margin="0,0,0,4"/>
<TextBox x:Name="TxtUsername"
Background="#07141d" Foreground="#eaf6ff"
BorderBrush="#12404f" BorderThickness="1"
Padding="10,8" FontFamily="Consolas" FontSize="14"
CaretBrush="#00d9ff"/>

<TextBlock Text="Описание (одной строкой — роль/кто ты):"
Foreground="#eaf6ff" FontSize="13" Margin="0,16,0,4"/>
<TextBox x:Name="TxtDescription"
AcceptsReturn="True" TextWrapping="Wrap"
Height="90"
Background="#07141d" Foreground="#eaf6ff"
BorderBrush="#12404f" BorderThickness="1"
Padding="10,8" FontFamily="Consolas" FontSize="13"
CaretBrush="#00d9ff"
VerticalScrollBarVisibility="Auto"/>

<TextBlock Text="Эти данные запрашиваются при первом запуске и используются в приветствии."
Foreground="#6f96a8" FontSize="11" Margin="0,8,0,0"
TextWrapping="Wrap"/>

<TextBlock Text="── ТЕСТЫ ИНСТРУМЕНТОВ ──"
Foreground="#6f96a8" FontSize="13" Margin="0,24,0,12"/>

<WrapPanel>
<Button Content="📖 Точное чтение" Width="180" Margin="0,0,8,8"
Background="#07141d" Foreground="#eaf6ff"
BorderBrush="#12404f" BorderThickness="1"
Padding="10,8" Cursor="Hand"
Click="TestReadExact_Click"/>
<Button Content="✏️ Точная перезапись" Width="180" Margin="0,0,8,8"
Background="#07141d" Foreground="#eaf6ff"
BorderBrush="#12404f" BorderThickness="1"
Padding="10,8" Cursor="Hand"
Click="TestWriteLines_Click"/>
<Button Content="➕ Вставка" Width="180" Margin="0,0,8,8"
Background="#07141d" Foreground="#eaf6ff"
BorderBrush="#12404f" BorderThickness="1"
Padding="10,8" Cursor="Hand"
Click="TestInsert_Click"/>
<Button Content="💾 Полная перезапись" Width="180" Margin="0,0,8,8"
Background="#07141d" Foreground="#eaf6ff"
BorderBrush="#12404f" BorderThickness="1"
Padding="10,8" Cursor="Hand"
Click="TestWriteFull_Click"/>
<Button Content="🧪 Полный тест GUI" Width="180" Margin="0,0,8,8"
Background="#0b2530" Foreground="#00d9ff"
BorderBrush="#00d9ff" BorderThickness="1"
Padding="10,8" FontWeight="Bold" Cursor="Hand"
Click="TestFullGui_Click"/>
</WrapPanel>

<TextBlock Text="Каждый тест пишет в logs/gui_test_*.log: действие, вход, результат, ОК/ОШИБКА."
Foreground="#6f96a8" FontSize="11" Margin="0,8,0,0"
TextWrapping="Wrap"/>

</StackPanel>
</ScrollViewer>

<!-- НИЗ -->
<Border Grid.Row="2" Background="#07141d" BorderBrush="#12404f" BorderThickness="0,1,0,0" Padding="16,10">
<Grid>
<TextBlock x:Name="StatusText" Foreground="#6f96a8" FontSize="12"
VerticalAlignment="Center"/>
<Button Content="Сохранить" HorizontalAlignment="Right"
Background="#0b2530" Foreground="#00d9ff"
BorderBrush="#00d9ff" BorderThickness="1"
Padding="18,8" FontFamily="Consolas" FontSize="13"
FontWeight="Bold" Cursor="Hand"
Click="Save_Click"/>
</Grid>
</Border>
</Grid>
</UserControl>