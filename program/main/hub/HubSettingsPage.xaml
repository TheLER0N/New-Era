<UserControl x:Class="Hub.HubSettingsPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Background="#050d13" FontFamily="Consolas" Focusable="True">
<UserControl.Resources>
  <SolidColorBrush x:Key="BgMain" Color="#050d13"/>
  <SolidColorBrush x:Key="BgPanel" Color="#07141d"/>
  <SolidColorBrush x:Key="BgCard" Color="#0a1620"/>
  <SolidColorBrush x:Key="Border" Color="#12404f"/>
  <SolidColorBrush x:Key="Accent" Color="#00d9ff"/>
  <SolidColorBrush x:Key="Ok" Color="#3fd158"/>
  <SolidColorBrush x:Key="Err" Color="#e94560"/>
  <SolidColorBrush x:Key="TextMain" Color="#eaf6ff"/>
  <SolidColorBrush x:Key="TextDim" Color="#7d93a5"/>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="StatCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Margin" Value="0,0,14,14"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="StatLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="InputBox" TargetType="TextBox">
    <Setter Property="Background" Value="#050d13"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>
  <Style x:Key="SideItem" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#0d2231"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="#001318"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="18,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnSecondary" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0d2231"/></Trigger>
    </Style.Triggers>
  </Style>
</UserControl.Resources>

<Grid Background="{StaticResource BgMain}">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- ══ ШАПКА: лого | заголовок | поиск | колокольчик | НАЗАД (справа) ══ -->
  <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="1" Background="#062028" Margin="0,0,12,0">
        <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Grid.Column="1" Text="НАСТРОЙКИ // HUB" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
      <Border Grid.Column="2" Background="#050d13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,6" MaxWidth="560" HorizontalAlignment="Left" MinWidth="260">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource Accent}" FontSize="12.5" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
          <Border Grid.Column="2" Background="#10222e" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
            <TextBlock Text="/" Foreground="{StaticResource TextDim}" FontSize="11"/>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="3" Margin="18,0,18,0" VerticalAlignment="Center">
        <TextBlock Text="🔔" FontSize="16" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
        <Border x:Name="BellBadge" Background="{StaticResource Err}" CornerRadius="8" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="Collapsed">
          <TextBlock x:Name="BellBadgeText" Text="1" Foreground="#ffffff" FontSize="10"/>
        </Border>
      </Grid>
      <Button Grid.Column="4" Content="← назад (Esc)" Style="{StaticResource BtnSecondary}" Click="BtnBack_Click" VerticalAlignment="Center"/>
    </Grid>
  </Border>

  <!-- ══ ТЕЛО ══ -->
  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Сайлбар -->
    <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="МЕНЮ" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="16,16,0,8"/>
        <StackPanel Grid.Row="1">
          <Button x:Name="MenuProfile"  Style="{StaticResource SideItem}" Tag="Profile"  Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="👤  " /><TextBlock Text="Профиль"/></StackPanel></Button>
          <Button x:Name="MenuTools"    Style="{StaticResource SideItem}" Tag="Tools"    Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="🛠  " /><TextBlock Text="Инструменты"/></StackPanel></Button>
          <Button x:Name="MenuTests"    Style="{StaticResource SideItem}" Tag="Tests"    Click="Menu_Click">
            <Grid Width="190"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><TextBlock Text="🧪  " /><TextBlock Text="Тесты"/></StackPanel>
              <Border Grid.Column="1" Background="{StaticResource Err}" CornerRadius="4" Padding="6,1" Visibility="Collapsed" x:Name="TestsBadge"><TextBlock x:Name="TestsBadgeText" Text="1" Foreground="#ffffff" FontSize="10"/></Border>
            </Grid>
          </Button>
          <Button x:Name="MenuLogs"     Style="{StaticResource SideItem}" Tag="Logs"     Click="Menu_Click">
            <Grid Width="190"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><TextBlock Text="📜  " /><TextBlock Text="Логи"/></StackPanel>
              <Border Grid.Column="1" Background="#10222e" CornerRadius="4" Padding="6,1"><TextBlock x:Name="LogsBadgeText" Text="0" Foreground="{StaticResource TextDim}" FontSize="10"/></Border>
            </Grid>
          </Button>
          <Button x:Name="MenuHotkeys"  Style="{StaticResource SideItem}" Tag="Hotkeys"  Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌨  " /><TextBlock Text="Горячие клавиши"/></StackPanel></Button>
          <Button x:Name="MenuAbout"    Style="{StaticResource SideItem}" Tag="About"    Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="ℹ  " /><TextBlock Text="О системе"/></StackPanel></Button>
        </StackPanel>
        <Border Grid.Row="2" Margin="12" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" Background="#08131c">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Ellipse x:Name="SystemStatusDot" Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,8,0"/>
              <TextBlock x:Name="SystemStatusText" Text="все системы OK" Foreground="{StaticResource TextMain}" FontSize="11.5"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Text="версия v1.0.0" Foreground="{StaticResource TextDim}" FontSize="10.5"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Контент -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,18">
      <StackPanel>
        <TextBlock x:Name="CrumbText" Text="Главная / Настройки / Профиль" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,0,16"/>

        <!-- ПРОФИЛЬ -->
        <StackPanel x:Name="PanelProfile">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <TextBlock Text="— ПРОФИЛЬ —" Style="{StaticResource SectionTitle}" Margin="0"/>
                <Border HorizontalAlignment="Right" BorderBrush="{StaticResource Ok}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                  <TextBlock Text="● online" Foreground="{StaticResource Ok}" FontSize="11"/>
                </Border>
              </Grid>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="68" Height="68" CornerRadius="34" Background="#0e3460" BorderBrush="{StaticResource Accent}" BorderThickness="2" Margin="0,0,18,0">
                  <TextBlock x:Name="ProfileAvatarLetter" Text="U" FontSize="26" FontWeight="Bold" Foreground="#eaf6ff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="ProfileName" Text="User" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProfileRole" Text="оператор LERON" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Background="#10222e" CornerRadius="4" Padding="8,3"><TextBlock Text="ID: 0042" Foreground="{StaticResource TextDim}" FontSize="10.5"/></Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Имя пользователя" Style="{StaticResource StatLabel}"/>
                  <TextBox x:Name="TxtUsername" Style="{StaticResource InputBox}" TextChanged="TxtUsername_TextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Описание (роль)" Style="{StaticResource StatLabel}"/>
                  <TextBox x:Name="TxtDescription" Style="{StaticResource InputBox}" TextChanged="TxtDescription_TextChanged"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
              <StackPanel><TextBlock Text="ЗАПИСЕЙ В ЛОГАХ" Style="{StaticResource StatLabel}"/><TextBlock x:Name="StatLogsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
              <StackPanel><TextBlock Text="СТАТУС ТЕСТОВ" Style="{StaticResource StatLabel}"/><TextBlock x:Name="StatTestsText" Text="нет данных" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDim}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,0,14">
              <StackPanel><TextBlock Text="ВРЕМЯ СЕССИИ" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SessionTimeText" Text="00:00:00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}"/></StackPanel>
            </Border>
          </Grid>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="АКТИВНОСТЬ" Style="{StaticResource SectionTitle}"/>
              <StackPanel x:Name="ActivityPanel"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ИНСТРУМЕНТЫ -->
        <StackPanel x:Name="PanelTools" Visibility="Collapsed">
          <Border Style="{StaticResource Card}"><TextBlock Text="— ИНСТРУМЕНТЫ — (в разработке)" Foreground="{StaticResource TextDim}"/></Border>
        </StackPanel>

        <!-- ТЕСТЫ -->
        <StackPanel x:Name="PanelTests" Visibility="Collapsed">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="— ТЕСТЫ —" Style="{StaticResource SectionTitle}"/>
              <StackPanel x:Name="TestsContainer" Margin="0,0,0,14"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnFullTest" Content="⚡ Полный тест GUI" Style="{StaticResource BtnPrimary}" Click="TestFullGui_Click"/>
                <TextBlock Text="  результат: logs\gui_test_result_*.txt" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ЛОГИ -->
        <StackPanel x:Name="PanelLogs" Visibility="Collapsed">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="— ЛОГИ —" Style="{StaticResource SectionTitle}"/>
              <StackPanel x:Name="LogsList" Margin="0,0,0,14"/>
              <Button Content="открыть папку логов" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Click="OpenLogsDir_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ГОРЯЧИЕ КЛАВИШИ -->
        <StackPanel x:Name="PanelHotkeys" Visibility="Collapsed">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="— ГОРЯЧИЕ КЛАВИШИ —" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Esc — закрыть настройки" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"/>
              <TextBlock Text="/ — фокус на поиск" Foreground="{StaticResource TextMain}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- О СИСТЕМЕ -->
        <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="— О СИСТЕМЕ —" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="DiagLog" Text="" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <!-- ══ ФУТЕР ══ -->
  <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,8,0"/>
        <TextBlock x:Name="FooterNick" Text="загружено: User" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="LogsCountText" Text="logs/gui_test_*.log: 0 записей" Foreground="{StaticResource TextDim}" FontSize="11.5" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Сброс" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="Reset_Click"/>
        <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Grid>
</UserControl>