<local:ChromeWindow x:Class="MainApp.SplashWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:MainApp"
Title="LERON GUI"
Background="#04150c"
Foreground="#c8ffd8">
<WindowChrome.WindowChrome>
<WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" NonClientFrameEdges="None"/>
</WindowChrome.WindowChrome>
<Grid x:Name="RootGrid" Background="#04150c">
<Border x:Name="TermOverlay" Background="#04150c">
<Grid x:Name="TermGrid" Margin="64,40">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Grid Grid.Row="0">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<TextBlock Text="LERON·GUI // CRT-9000" FontFamily="Consolas" FontSize="16" Foreground="#3f8a5f"/>
<TextBlock Grid.Column="1" Text="60HZ // P1 PHOSPHOR" FontFamily="Consolas" FontSize="16" Foreground="#3f8a5f" HorizontalAlignment="Right"/>
</Grid>
<StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,18,0,26">
<TextBlock Text="L E R O N   G U I" FontFamily="Consolas" FontSize="72" FontWeight="Bold" Foreground="#00ff88" HorizontalAlignment="Center">
<TextBlock.Effect>
<DropShadowEffect Color="#00ff88" BlurRadius="28" ShadowDepth="0"/>
</TextBlock.Effect>
</TextBlock>
<TextBlock Text="─── терминальная система · v2.6 ───" FontFamily="Consolas" FontSize="18" Foreground="#4a8a63" HorizontalAlignment="Center" Margin="0,10,0,0"/>
</StackPanel>
<ScrollViewer Grid.Row="2" x:Name="TermScroll" VerticalScrollBarVisibility="Hidden">
<TextBlock x:Name="TermText" FontFamily="Consolas" FontSize="25" Foreground="#7dffa8" TextWrapping="Wrap" LineHeight="38" LineStackingStrategy="BlockLineHeight"/>
</ScrollViewer>
<StackPanel Grid.Row="3" x:Name="InputLine" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
<TextBlock Text="&gt; " FontFamily="Consolas" FontSize="24" Foreground="#00ff88" VerticalAlignment="Center"/>
<TextBox x:Name="InputBox" Width="900" Background="Transparent" BorderThickness="0"
FontFamily="Consolas" FontSize="24" Foreground="#d9ffe7" CaretBrush="#00ff88"
SelectionBrush="#123626" VerticalAlignment="Center" KeyDown="OnInputKeyDown"/>
</StackPanel>
<StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,20,0,0">
<TextBlock x:Name="BarText" FontFamily="Consolas" FontSize="22" Foreground="#00ff88" HorizontalAlignment="Center" Visibility="Collapsed">
<TextBlock.Effect>
<DropShadowEffect Color="#00ff88" BlurRadius="10" ShadowDepth="0"/>
</TextBlock.Effect>
</TextBlock>
<TextBlock x:Name="HintText" FontFamily="Consolas" FontSize="15" Foreground="#2a5a40" Text="[пробел] — пропустить заставку" HorizontalAlignment="Center" Margin="0,10,0,0"/>
</StackPanel>
</Grid>
</Border>
</Grid>
</local:ChromeWindow>