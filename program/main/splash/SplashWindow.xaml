<local:ChromeWindow x:Class="MainApp.SplashWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:MainApp"
Title="LERON GUI"
Background="#04150c"
Foreground="#c8ffd8">
<WindowChrome.WindowChrome>
<WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" NonClientFrameEdges="None"/>
</WindowChrome.WindowChrome>
<Grid x:Name="RootGrid" Background="#04150c">
<Border x:Name="TermOverlay" Background="#04150c">
<Grid x:Name="TermGrid" Margin="56,36">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Grid Grid.Row="0">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<TextBlock Text="LERON-GUI // CRT-9000" FontFamily="Consolas" FontSize="15" Foreground="#3f8a5f"/>
<TextBlock Grid.Column="1" Text="60HZ // P1 PHOSPHOR // UEFI" FontFamily="Consolas" FontSize="15" Foreground="#3f8a5f" HorizontalAlignment="Right"/>
</Grid>
<StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,18">
<TextBlock Text="L E R O N   G U I" FontFamily="Consolas" FontSize="72" FontWeight="Bold" Foreground="#00ff88" HorizontalAlignment="Center">
<TextBlock.Effect>
<DropShadowEffect Color="#00ff88" BlurRadius="28" ShadowDepth="0"/>
</TextBlock.Effect>
</TextBlock>
<TextBlock Text="─── терминальная система · v2.6 ───" FontFamily="Consolas" FontSize="18" Foreground="#4a8a63" HorizontalAlignment="Center" Margin="0,10,0,0"/>
<Border Background="#0d2418" BorderBrush="#1d5c3d" BorderThickness="1" CornerRadius="8" Padding="14,5" HorizontalAlignment="Center" Margin="0,14,0,0">
<TextBlock Text="BUILD 2026.01 · x86_64" FontFamily="Consolas" FontSize="14" Foreground="#7dffa8"/>
</Border>
</StackPanel>
<Grid Grid.Row="2">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="430"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="430"/>
</Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" VerticalAlignment="Top">
<TextBlock Text="── ТЕРМИНАЛ ──" FontFamily="Consolas" FontSize="14" Foreground="#3f8a5f" Margin="0,0,0,10"/>
<ScrollViewer x:Name="TermScroll" VerticalScrollBarVisibility="Hidden" MaxHeight="420" HorizontalAlignment="Left">
<TextBlock x:Name="TermText" FontFamily="Consolas" FontSize="17" Foreground="#7dffa8" TextWrapping="Wrap" LineHeight="28" LineStackingStrategy="BlockLineHeight"/>
</ScrollViewer>
<StackPanel x:Name="InputLine" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
<TextBlock Text="&gt; " FontFamily="Consolas" FontSize="17" Foreground="#00ff88" VerticalAlignment="Center"/>
<TextBox x:Name="InputBox" Width="360" Background="Transparent" BorderThickness="0"
FontFamily="Consolas" FontSize="17" Foreground="#d9ffe7" CaretBrush="#00ff88"
SelectionBrush="#123626" VerticalAlignment="Center" KeyDown="OnInputKeyDown"/>
</StackPanel>
</StackPanel>
<StackPanel Grid.Column="2" VerticalAlignment="Top">
<TextBlock Text="── СЕССИЯ ──" FontFamily="Consolas" FontSize="14" Foreground="#3f8a5f" Margin="0,0,0,10"/>
<Grid TextElement.FontFamily="Consolas" TextElement.FontSize="15">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="130"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<TextBlock Text="пользователь" Foreground="#447a5a" Margin="0,0,0,6"/>
<TextBlock Grid.Column="1" x:Name="SessionUser" Text="—" Foreground="#c8ffd8" Margin="0,0,0,6"/>
<TextBlock Grid.Row="1" Text="роль" Foreground="#447a5a" Margin="0,0,0,6"/>
<TextBlock Grid.Row="1" Grid.Column="1" x:Name="SessionRole" Text="coder" Foreground="#c8ffd8" Margin="0,0,0,6"/>
<TextBlock Grid.Row="2" Text="режим" Foreground="#447a5a" Margin="0,0,0,6"/>
<TextBlock Grid.Row="2" Grid.Column="1" x:Name="SessionMode" Text="аккуратный · быстро" Foreground="#c8ffd8" Margin="0,0,0,6"/>
<TextBlock Grid.Row="3" Text="проект" Foreground="#447a5a" Margin="0,0,0,6"/>
<TextBlock Grid.Row="3" Grid.Column="1" x:Name="SessionProject" Text="—" Foreground="#00ff88" Margin="0,0,0,6"/>
<TextBlock Grid.Row="4" Text="история" Foreground="#447a5a"/>
<TextBlock Grid.Row="4" Grid.Column="1" x:Name="SessionHistory" Text="0 сообщений" Foreground="#c8ffd8"/>
</Grid>
<TextBlock Text="── ДИАГНОСТИКА ──" FontFamily="Consolas" FontSize="14" Foreground="#3f8a5f" Margin="0,18,0,10"/>
<TextBlock x:Name="DiagLog" FontFamily="Consolas" FontSize="15" Foreground="#7dffa8" LineHeight="26" LineStackingStrategy="BlockLineHeight"/>
</StackPanel>
</Grid>
<StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,16,0,0">
<TextBlock Text="загрузка модулей ядра" FontFamily="Consolas" FontSize="14" Foreground="#4a8a63" HorizontalAlignment="Center" Margin="0,0,0,8"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
<TextBlock Text="[" FontFamily="Consolas" FontSize="22" Foreground="#00ff88" VerticalAlignment="Center"/>
<TextBlock x:Name="BarText" FontFamily="Consolas" FontSize="18" Foreground="#00ff88" Margin="8,0,8,0" VerticalAlignment="Center">
<TextBlock.Effect>
<DropShadowEffect Color="#00ff88" BlurRadius="10" ShadowDepth="0"/>
</TextBlock.Effect>
</TextBlock>
<TextBlock Text="]" FontFamily="Consolas" FontSize="22" Foreground="#00ff88" VerticalAlignment="Center"/>
<TextBlock x:Name="PercentText" Text="0%" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#00ff88" Margin="14,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
<TextBlock x:Name="HintText" FontFamily="Consolas" FontSize="14" Foreground="#2a5a40" Text="[пробел] — пропустить заставку" HorizontalAlignment="Center" Margin="0,10,0,0"/>
</StackPanel>
<Grid Grid.Row="4" Margin="0,14,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<TextBlock x:Name="FooterLeft" Text="© 2026 LERON SYSTEMS" FontFamily="Consolas" FontSize="13" Foreground="#2f6a4a"/>
<TextBlock x:Name="FooterRight" Text="USER: — // TTY1" FontFamily="Consolas" FontSize="13" Foreground="#2f6a4a" HorizontalAlignment="Right" Grid.Column="1"/>
</Grid>
</Grid>
</Border>
<Border Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16" BorderBrush="#00ff88" BorderThickness="2,2,0,0"/>
<Border Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,16" BorderBrush="#00ff88" BorderThickness="0,2,2,0"/>
<Border Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,16" BorderBrush="#00ff88" BorderThickness="2,0,0,2"/>
<Border Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,16" BorderBrush="#00ff88" BorderThickness="0,0,2,2"/>
<Border x:Name="BlackStart" Background="#000000" IsHitTestVisible="False" Panel.ZIndex="100"/>
</Grid>
</local:ChromeWindow>