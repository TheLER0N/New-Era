<UserControl x:Class="MainApp.Memory.MemoryPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Background="#050d13" FontFamily="Consolas" Focusable="True">
<UserControl.Resources>
  <SolidColorBrush x:Key="BgMain" Color="#050d13"/>
  <SolidColorBrush x:Key="BgPanel" Color="#07141d"/>
  <SolidColorBrush x:Key="BgCard" Color="#0a1620"/>
  <SolidColorBrush x:Key="Border" Color="#12404f"/>
  <SolidColorBrush x:Key="Accent" Color="#00d9ff"/>
  <SolidColorBrush x:Key="Ok" Color="#3fd158"/>
  <SolidColorBrush x:Key="Err" Color="#e94560"/>
  <SolidColorBrush x:Key="TextMain" Color="#eaf6ff"/>
  <SolidColorBrush x:Key="TextDim" Color="#7d93a5"/>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FilterBtn" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="10,6" CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0d2231"/></Trigger>
    </Style.Triggers>
  </Style>
</UserControl.Resources>

<Grid Background="{StaticResource BgMain}">
<!-- ROUND 6 TOOLBAR -->
  <Grid.RowDefinitions>
<!-- ROUND 6 TOOLBAR -->
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- ШАПКА -->
  <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
    <Grid>
<!-- ROUND 6 TOOLBAR -->
      <Grid.ColumnDefinitions>
<!-- ROUND 6 TOOLBAR -->
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="1" Background="#062028" Margin="0,0,12,0">
        <TextBlock Text="🧠" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="ПАМЯТЬ // " Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock x:Name="ProjectNameText" Text="проект" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Grid.Column="2" Content="← назад (Esc)" Click="BtnBack_Click" 
              Background="Transparent" BorderBrush="{StaticResource Border}" BorderThickness="1" 
              Foreground="{StaticResource TextMain}" Padding="14,7" Cursor="Hand">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>
  </Border>

  <!-- ОСНОВНОЙ КОНТЕНТ -->
  <Grid Grid.Row="1">
<!-- ROUND 6 TOOLBAR -->
    <Grid.ColumnDefinitions>
<!-- ROUND 6 TOOLBAR -->
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ФИЛЬТР -->
    <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="12">
      <StackPanel>
        <TextBlock Text="КАТЕГОРИИ" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,0,0,10"/>
        <Button x:Name="FilterAll" Style="{StaticResource FilterBtn}" Click="Filter_Click" Tag="all" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource TextDim}" Margin="0,0,8,0"/>
            <TextBlock Text="Все" Foreground="{StaticResource TextMain}"/>
          </StackPanel>
        </Button>
        <Button x:Name="FilterChoices" Style="{StaticResource FilterBtn}" Click="Filter_Click" Tag="choices" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#00d9ff" Margin="0,0,8,0"/>
            <TextBlock x:Name="ChoicesCount" Text="выборы (0)" Foreground="{StaticResource TextMain}"/>
          </StackPanel>
        </Button>
        <Button x:Name="FilterFacts" Style="{StaticResource FilterBtn}" Click="Filter_Click" Tag="facts" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#3fd158" Margin="0,0,8,0"/>
            <TextBlock x:Name="FactsCount" Text="факты (0)" Foreground="{StaticResource TextMain}"/>
          </StackPanel>
        </Button>
        <Button x:Name="FilterFiles" Style="{StaticResource FilterBtn}" Click="Filter_Click" Tag="files" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#ff9f43" Margin="0,0,8,0"/>
            <TextBlock x:Name="FilesCount" Text="файлы (0)" Foreground="{StaticResource TextMain}"/>
          </StackPanel>
        </Button>
        <Button x:Name="FilterNotes" Style="{StaticResource FilterBtn}" Click="Filter_Click" Tag="notes">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#ffd166" Margin="0,0,8,0"/>
            <TextBlock x:Name="NotesCount" Text="заметки (0)" Foreground="{StaticResource TextMain}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- СПИСОК КАРТОЧЕК -->
    <!-- ГРАФ СВЯЗЕЙ -->
    <Grid Grid.Column="1" Margin="0,0,0,12">
<!-- ROUND 6 TOOLBAR -->
      <Grid.RowDefinitions>
<!-- ROUND 6 TOOLBAR -->
        <RowDefinition Height="320"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      
      <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
        <Grid>
<!-- ROUND 6 TOOLBAR -->
          <TextBlock Text="ГРАФ СВЯЗЕЙ" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" 
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8,0,0"/>
          <Canvas x:Name="GraphCanvas" ClipToBounds="True" Background="Transparent"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
    <Button Content="+ карточка" Click="BtnAddCard_Click" Margin="0,0,6,0" Padding="10,6" Background="#12404f" Foreground="#00d9ff" BorderBrush="#00d9ff"/>
    <Button Content="экспорт" Click="BtnExport_Click" Margin="0,0,6,0" Padding="10,6" Background="#12404f" Foreground="#00d9ff" BorderBrush="#00d9ff"/>
    <Button Content="импорт" Click="BtnImport_Click" Margin="0,0,6,0" Padding="10,6" Background="#12404f" Foreground="#00d9ff" BorderBrush="#00d9ff"/>
    <Button Content="забыть всё" Click="BtnForgetAll_Click" Padding="10,6" Background="#401212" Foreground="#ff4d4d" BorderBrush="#ff4d4d"/>
</StackPanel>
<TextBlock Text="ДОЛГОСРОЧНАЯ ПАМЯТЬ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
          <StackPanel x:Name="CardsList"/>
          
          <TextBlock Text="КРАТКОСРОЧНАЯ ПАМЯТЬ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" Margin="0,20,0,12"/>
          <StackPanel x:Name="ShortTermList"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>

  <!-- ФУТЕР -->
  <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
    <TextBlock x:Name="StatusText" Text="готово" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
  </Border>

    
        <Border x:Name="InspectorPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC050d13" HorizontalAlignment="Right" Width="320">
            <Border Background="#0a1620" BorderBrush="#12404f" BorderThickness="1" CornerRadius="10" Margin="10" Padding="14">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="InspectorTitle" Text="" Foreground="#eaf6ff" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,28,0"/>
                        <Button Content="✕" Click="InspectorClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="#7d93a5" BorderThickness="0" FontSize="14" Padding="4,2" Cursor="Hand"/>
                    </Grid>

                    <TextBlock x:Name="InspectorId" Text="" Foreground="#7d93a5" FontSize="11" Margin="0,4,0,0"/>

                    <Border x:Name="InspectorCatBadge" Background="#12404f33" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock x:Name="InspectorCat" Text="" Foreground="#00d9ff" FontSize="11"/>
                    </Border>

                    <TextBlock x:Name="InspectorText" Text="" Foreground="#eaf6ff" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <TextBlock Text="Связи:" Foreground="#7d93a5" FontSize="11" Margin="0,8,0,2"/>
                    <TextBlock x:Name="InspectorLinks" Text="" Foreground="#eaf6ff" FontSize="11" TextWrapping="Wrap"/>

                    <TextBlock x:Name="InspectorTime" Text="" Foreground="#7d93a5" FontSize="10" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="✎" Click="InspectorEdit_Click" Margin="0,0,8,0" Padding="10,6" Background="#12404f" Foreground="#00d9ff" BorderBrush="#00d9ff" Cursor="Hand"/>
                        <Button Content="✖" Click="InspectorDelete_Click" Padding="10,6" Background="#401212" Foreground="#ff4d4d" BorderBrush="#ff4d4d" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    
        <Border x:Name="FormOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#0a1620" BorderBrush="#12404f" BorderThickness="1" CornerRadius="10" Width="420" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="" Foreground="#00d9ff" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="Категория" Foreground="#7d93a5" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FormCat" Margin="0,0,0,12" SelectedIndex="0">
                        <ComboBoxItem Tag="choices" Content="choices"/>
                        <ComboBoxItem Tag="facts" Content="facts"/>
                        <ComboBoxItem Tag="files" Content="files"/>
                        <ComboBoxItem Tag="notes" Content="notes"/>
                    </ComboBox>

                    <TextBlock Text="Заголовок" Foreground="#7d93a5" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="FormTitleBox" Margin="0,0,0,12" Padding="8,6" Background="#050d13" Foreground="#eaf6ff" BorderBrush="#12404f" BorderThickness="1"/>

                    <TextBlock Text="Текст" Foreground="#7d93a5" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="FormTextBox" Margin="0,0,0,16" Padding="8,6" Height="120" Background="#050d13" Foreground="#eaf6ff" BorderBrush="#12404f" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Click="FormCancel_Click" Margin="0,0,8,0" Padding="12,8" Background="Transparent" Foreground="#7d93a5" BorderBrush="#12404f" BorderThickness="1" Cursor="Hand"/>
                        <Button Content="Сохранить" Click="FormSave_Click" Padding="12,8" Background="#12404f" Foreground="#00d9ff" BorderBrush="#00d9ff" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>



