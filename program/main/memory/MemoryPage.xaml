<UserControl x:Class="MainApp.Memory.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#07141d">
  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#00d9ff"/><Setter Property="Background" Value="#0d2530"/>
      <Setter Property="BorderBrush" Value="#1b4a5e"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Background="#07141d">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#0a1a24">
      <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
        <Border Width="34" Height="34" CornerRadius="8" BorderBrush="#00d9ff" BorderThickness="1" Background="#0d2530" Margin="0,0,10,0">
          <TextBlock Text="🧠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="ПАМЯТЬ" Foreground="#00d9ff" FontFamily="Consolas" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text=" // " Foreground="#3d5a6a" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock x:Name="ProjectNameText" Text="—" Foreground="#e8f6ff" FontFamily="Consolas" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="BtnBack" Content="← назад (Esc)" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Click="OnBack"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#0a1a24" BorderBrush="#12303f" BorderThickness="0,0,1,0">
        <StackPanel x:Name="SidePanel" Margin="14"/>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#081720" BorderBrush="#12303f" BorderThickness="1" Margin="10,10,10,5">
          <Grid>
            <Canvas x:Name="GraphCanvas" Background="Transparent" ClipToBounds="True"
                    MouseLeftButtonDown="OnDown" MouseLeftButtonUp="OnUp" MouseMove="OnMove" MouseWheel="OnWheel"/>
            <TextBlock Text="ГРАФ СВЯЗЕЙ" Foreground="#00d9ff" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                       Margin="14,10" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
              <Button x:Name="BtnZoomIn" Content="+" Padding="8,4" Click="OnZoomIn"/>
              <Button x:Name="BtnZoomOut" Content="−" Padding="8,4" Click="OnZoomOut"/>
              <Button x:Name="BtnReset" Content="⟳" Padding="8,4" Click="OnReset"/>
              <Button x:Name="Btn3D" Content="3D" Padding="10,4" Click="On3D"/>
            </StackPanel>
            <StackPanel x:Name="LegendPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12" IsHitTestVisible="False"/>
            <TextBlock x:Name="GraphStat" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10"
                       Foreground="#7d93a5" FontFamily="Consolas" FontSize="11" IsHitTestVisible="False"/>
            <Border x:Name="TooltipCard" Visibility="Collapsed" Background="#0c222d" BorderBrush="#1b4a5e" BorderThickness="1"
                    CornerRadius="6" Padding="10" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
              <StackPanel>
                <TextBlock x:Name="TipTitle" Foreground="#e8f6ff" FontWeight="Bold" FontFamily="Consolas"/>
                <TextBlock x:Name="TipMeta" Foreground="#7d93a5" FontFamily="Consolas" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock x:Name="TipLinks" Foreground="#7d93a5" FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#07141d" Margin="10,5,10,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="BtnAdd" Content="+ карточка" Background="#00d9ff" Foreground="#062028" FontWeight="Bold" Click="OnAdd"/>
              <Button x:Name="BtnExport" Content="экспорт" Click="OnExport"/>
              <Button x:Name="BtnImport" Content="импорт" Click="OnImport"/>
              <Button x:Name="BtnForget" Content="забыть всё" Foreground="#ff5566" BorderBrush="#7a2733" Background="#2a0d13" Click="OnForget"/>
            </StackPanel>
            <TextBlock Text="ДОЛГОСРОЧНАЯ ПАМЯТЬ" Foreground="#00d9ff" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel x:Name="LongPanel"/>
            <TextBlock Text="КРАТКОСРОЧНАЯ ПАМЯТЬ" Foreground="#00d9ff" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,14,0,8"/>
            <StackPanel x:Name="ShortPanel"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Background="#0a1a24">
      <TextBlock x:Name="StatusLeft" VerticalAlignment="Center" Margin="14,0" Foreground="#7d93a5" FontFamily="Consolas" FontSize="11"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock Text="3D граф" Foreground="#7d93a5" FontFamily="Consolas" FontSize="11"/>
        <TextBlock x:Name="FpsText" Text="60 FPS" Foreground="#7d93a5" FontFamily="Consolas" FontSize="11" Margin="18,0,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>