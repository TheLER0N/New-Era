    {
      "Author": "\u0422\u044B",
      "Text": "\u0421\u0434\u0435\u043B\u0430\u0439 \u043C\u043D\u0435 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440 \u043D\u0430 C#",
