  "proj|c:\\users\\\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\\desktop\\test_qwen": [
    {
      "Author": "\u0422\u044B",
      "Text": "\u0421\u043E\u0437\u0434\u0430\u0439 \u043C\u043D\u0435 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440 \u043D\u0430 C# \u0441 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u043C UI. \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u043F\u0440\u043E \u0431\u0430\u0442\u043D\u0438\u043A \u0441\u043E \u0441\u0431\u043E\u0440\u043A\u043E\u0439 \u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u043E\u043C. \u0421\u043E\u0431\u0435\u0440\u0438 \u043C\u043D\u0435 \u043D\u0430 winform",
      "Bg": "#0f3460"
    },
    {
      "Author": "coder",
      "Text": "\u041A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440 \u043D\u0430 C# WinForms \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0441\u043E\u0437\u0434\u0430\u043D \u0438 \u0441\u043E\u0431\u0440\u0430\u043D. \u0418\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D \u0432 \u0442\u0435\u043C\u043D\u043E\u0439 \u0442\u0435\u043C\u0435 \u0441 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C\u0438 \u043A\u043D\u043E\u043F\u043A\u0430\u043C\u0438. \u0412 \u043A\u043E\u0440\u043D\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0444\u0430\u0439\u043B build_and_run.bat \u0434\u043B\u044F \u0443\u0434\u043E\u0431\u043D\u043E\u0439 \u0441\u0431\u043E\u0440\u043A\u0438 \u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0430 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F.",
      "Bg": "#16213e"
    },
    {
      "Author": "\u0422\u044B",
      "Text": "\u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0435\u043A\u0442",
      "Bg": "#0f3460"
    },
    {
      "Author": "coder",
      "Text": "\u041F\u0440\u043E\u0435\u043A\u0442 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F (dotnet build \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 0 \u043E\u0448\u0438\u0431\u043E\u043A). \u0411\u0430\u0442\u043D\u0438\u043A build_and_run.bat \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0438 \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D.",
      "Bg": "#16213e"
    },
    {
      "Author": "\u0422\u044B",
      "Text": "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u043C\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442. \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u043F\u0440\u043E\u0435\u043A\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 C:\\Users\\\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\\Desktop\\test_qwen, \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435 \u043F\u0443\u0442\u044C \u043A \u043F\u0440\u043E\u0435\u043A\u0442\u0443 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E --project.",
      "Bg": "#0f3460"
    },
    {
      "Author": "coder",
      "Text": "\u041F\u0440\u043E\u0435\u043A\u0442 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F. \u041E\u0448\u0438\u0431\u043A\u0430 \u0027\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u043C\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442\u0027 \u0431\u044B\u043B\u0430 \u0441\u0432\u044F\u0437\u0430\u043D\u0430 \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u043B\u0430\u0441\u044C \u0438\u0437 \u043A\u043E\u0440\u043D\u044F \u0431\u0435\u0437 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u043F\u0443\u0442\u0438 \u043A .csproj. \u0421\u0430\u043C \u043A\u043E\u0434 \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0438 \u0431\u0430\u0442\u043D\u0438\u043A (build_and_run.bat) \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B. \u0411\u0430\u0442\u043D\u0438\u043A \u0442\u0435\u043F\u0435\u0440\u044C \u044F\u0432\u043D\u043E \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 --project Calculator.csproj \u0434\u043B\u044F \u043D\u0430\u0434\u0435\u0436\u043D\u043E\u0441\u0442\u0438.",
      "Bg": "#16213e"
    },
    {
      "Author": "\u0422\u044B",
      "Text": "\u043F\u0435\u0440\u0435\u0441\u043E\u0431\u0435\u0440\u0438 \u043C\u043D\u0435 \u0431\u0430\u0442\u043D\u0438\u043A \u0434\u043B\u044F \u0441\u0431\u043E\u0440\u043A\u0438 \u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0430 \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0430 \u0442\u0430\u043A \u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u0439 UI \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0430\u043A \u043A\u0430\u043A \u0442\u0430\u043C \u043D\u0435 \u0432\u0441\u0451 \u0432\u043B\u0430\u0437\u0438\u0435\u0442 \u0438 \u043F\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u0435\u0435",
      "Bg": "#0f3460"
    },
    {
      "Author": "coder",
      "Text": "UI \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D: \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D \u0440\u0430\u0437\u043C\u0435\u0440 \u043E\u043A\u043D\u0430 (400x600), \u0448\u0440\u0438\u0444\u0442 \u0434\u0438\u0441\u043F\u043B\u0435\u044F \u0441\u0442\u0430\u043B \u043A\u0440\u0443\u043F\u043D\u0435\u0435 (42pt), \u043A\u043D\u043E\u043F\u043A\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u0438 \u0441 \u044D\u0444\u0444\u0435\u043A\u0442\u0430\u043C\u0438 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F. \u0426\u0432\u0435\u0442\u043E\u0432\u0430\u044F \u0441\u0445\u0435\u043C\u0430 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0430. \u0411\u0430\u0442\u043D\u0438\u043A build_and_run.bat \u043F\u0435\u0440\u0435\u0441\u043E\u0437\u0434\u0430\u043D \u0432 \u043A\u043E\u0440\u043D\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0441 \u044F\u0432\u043D\u044B\u043C \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435\u043C \u043F\u0443\u0442\u0438 \u043A \u043F\u0440\u043E\u0435\u043A\u0442\u0443. \u0421\u0431\u043E\u0440\u043A\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0443\u0441\u043F\u0435\u0448\u043D\u043E.",
      "Bg": "#16213e"
    }
  ],
